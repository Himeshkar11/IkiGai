PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ikigai?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Data Retention & Database Hygiene
# Enable automated 1st-of-the-month retention cleanup (default: false, manual via "npm run cleanup")
ENABLE_MONTHLY_CLEANUP=false

# Keep-Alive & Health Check Monitoring
# Production URL targeted by the 5-minute health check keepalive
APP_URL=https://your-production-domain.com
HEALTH_CHECK_URL=https://your-production-domain.com/health
